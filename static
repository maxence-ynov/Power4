/* Centrer la page */
body {
    font-family: Arial, sans-serif;
    text-align: center;
    background: #f4f4f4;
}

/* Titre */
h2, h3 {
    margin: 10px;
}

/* Tableau du jeu */
table {
    border-collapse: collapse;
    margin: 20px auto;
}

/* Cellules */
td {
    width: 60px;
    height: 60px;
    border: 2px solid #333;
    text-align: center;
    vertical-align: middle;
}

/* Jetons */
.cell {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    margin: auto;
}

/* Couleurs des joueurs */
.p1 {
    background: red;
}

.p2 {
    background: yellow;
}

/* Boutons pour jouer */
button {
    width: 100%;
    height: 30px;
    font-size: 16px;
    cursor: pointer;
}
